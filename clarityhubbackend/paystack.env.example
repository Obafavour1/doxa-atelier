# Paystack is initialized and verified only by the backend.
PAYSTACK_SECRET_KEY=sk_test_xxx

# Paystack receives NGN. Stripe and the product catalogue remain in USD.
PAYSTACK_CURRENCY=NGN

# Business conversion rate used to quote and charge Paystack payments.
# Review this regularly before accepting live payments.
PAYSTACK_NGN_PER_USD=1600

# Comma-separated frontend/admin origins allowed to call the API.
# Do not use a wildcard when credentials are enabled.
CORS_ORIGINS=https://doxa-atelier.vercel.app
